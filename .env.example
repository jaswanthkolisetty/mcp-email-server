# Copy this file to .env and fill in your real values.
# Never commit .env to GitHub — it contains secrets.

# Azure AD App Registration credentials (from portal.azure.com)
TENANT_ID=your-azure-tenant-id
CLIENT_ID=your-azure-client-id
CLIENT_SECRET=your-azure-client-secret

# The Outlook mailbox to read emails from
USER_EMAIL=your@email.com

# API key to protect the remote MCP endpoint (choose any strong random string)
API_KEY=choose-a-strong-random-key
